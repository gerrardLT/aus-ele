FINGRID_API_KEY=your-key-here
FINGRID_BASE_URL=https://data.fingrid.fi/api
FINGRID_REQUEST_INTERVAL_SECONDS=6.5
FINGRID_TIMEOUT_SECONDS=30
FINGRID_DEFAULT_BACKFILL_START=2014-01-01T00:00:00Z
FINGRID_DEFAULT_INCREMENTAL_LOOKBACK_DAYS=30
NORDPOOL_API_BASE_URL=https://data-api.nordpoolgroup.com
NORDPOOL_ACCESS_TOKEN=
NORDPOOL_API_KEY=
NORDPOOL_TOKEN_URL=
NORDPOOL_CLIENT_ID=
NORDPOOL_CLIENT_SECRET=
ENTSOE_API_BASE_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_SECURITY_TOKEN=
ENTSOE_TIMEOUT_SECONDS=30
# Database backend: 'sqlite' (default) or 'postgresql'
AUS_ELE_DB_BACKEND=postgresql
AUS_ELE_DB_PATH=G:\\project\\aus-ele\\data\\aemo_data.db

# PostgreSQL connection (required when AUS_ELE_DB_BACKEND=postgresql)
AUS_ELE_PG_HOST=localhost
AUS_ELE_PG_PORT=5432
AUS_ELE_PG_DATABASE=aemo_data
AUS_ELE_PG_USER=aemo
AUS_ELE_PG_PASSWORD=your-pg-password
AUS_ELE_PG_MIN_CONNECTIONS=2
AUS_ELE_PG_MAX_CONNECTIONS=10
AUS_ELE_PG_CONNECT_TIMEOUT=10

# PostgreSQL host port (for docker-compose port mapping)
PG_HOST_PORT=15432

AUS_ELE_ENABLE_SCHEDULER=false
AUS_ELE_ENABLE_JOB_WORKER=false
AUS_ELE_WORKER_ENABLE_SCHEDULER=true
AUS_ELE_WORKER_ENABLE_JOB_WORKER=true
AUS_ELE_MARKET_SYNC_HOUR=1
AUS_ELE_MARKET_SYNC_MINUTE=20
AUS_ELE_FINGRID_HOURLY_SYNC_MINUTE=45
AUS_ELE_FINGRID_DAILY_SYNC_HOUR=4
AUS_ELE_FINGRID_DAILY_SYNC_MINUTE=10
AUS_ELE_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUS_ELE_CORS_ALLOW_CREDENTIALS=false

# JWT authentication (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUS_ELE_JWT_SECRET=
AUS_ELE_ACCESS_TOKEN_TTL_SECONDS=3600
AUS_ELE_SESSION_TTL_SECONDS=2592000

# External shared state (rate-limit windows / OAuth state / quota cache).
# Empty or unreachable Redis degrades to the in-process fallback — it never blocks requests.
REDIS_URL=redis://127.0.0.1:6379/0
AUS_ELE_STATE_PREFIX=aemo_state
AUS_ELE_LOCAL_CACHE_MAX_ENTRIES=256

# --- Auth hardening (P0.2 / P0.5 / P0.6) ------------------------------------
# Role granted to the anonymous bootstrap principal (workspace ws_default).
# Illegal values fall back to "viewer" (fail-closed). Set "owner" only to roll back
# P0.2 behaviour on a private deployment.
AUS_ELE_BOOTSTRAP_ROLE=viewer
# PBKDF2 iterations written for NEW hashes; existing hashes are re-hashed transparently
# on successful login. Clamped to a 120000 floor: a typo with fewer digits must not
# write a hash weaker than the existing population (that would be irreversible).
AUS_ELE_PBKDF2_ITERATIONS=600000
# Per-IP sliding-window login throttle (attempts / 60s window).
AUS_ELE_LOGIN_RATE_LIMIT=5
# Legacy OIDC callback (trusts an unsigned `email` query param). Defaults to OFF and
# returns 501; re-enabling it is a security regression — tracked as its own task.
AUS_ELE_ENABLE_LEGACY_OIDC_CALLBACK=false
# Same-origin allowlist for the web session bootstrap endpoint (comma separated).
AUS_ELE_WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUS_ELE_WEB_SESSION_RATE_LIMIT=30
AUS_ELE_WEB_SESSION_RATE_LIMIT_WINDOW=60

# --- Account system (R1.1 self-service register + email verification) -------
# Absolute prefix for links inside emails (verification / reset). MUST be set in
# production, otherwise every mailed link points at localhost.
AUS_ELE_PUBLIC_BASE_URL=http://localhost:5173
# Master switch for /api/v1/register*. false => register + resend return 403;
# existing accounts keep logging in and verifying.
AUS_ELE_ENABLE_SELF_SERVICE_REGISTER=true
AUS_ELE_EMAIL_VERIFY_TTL_SECONDS=86400
# When SMTP is unconfigured: true => mark new emails verified immediately (dev only,
# audited + logged); false => stay unverified and show the banner. Set false in prod.
AUS_ELE_AUTO_VERIFY_WHEN_NO_SMTP=true
# Password policy floors are clamped — a smaller value is rejected, not applied.
AUS_ELE_PASSWORD_MIN_LENGTH=12
AUS_ELE_PASSWORD_MAX_LENGTH=256
# Register / resend / reset throttles (count / window).
AUS_ELE_REGISTER_IP_LIMIT=10
AUS_ELE_RESEND_VERIFY_LIMIT=3
AUS_ELE_RESEND_VERIFY_IP_LIMIT=20
AUS_ELE_RESET_REQ_IP_LIMIT=20
AUS_ELE_RESET_REQ_EMAIL_LIMIT=5
AUS_ELE_INVITE_ACCEPT_RATE_LIMIT=10
AUS_ELE_QUOTA_CACHE_TTL_SECONDS=60

# --- Social login (R1.2 Google / GitHub authorization-code + PKCE) ----------
# Master switch. false => /start and /providers return 404 / [] and the buttons vanish.
# A provider is additionally only offered when BOTH client id and secret are set, so
# leaving the credentials empty is itself the feature flag.
AUS_ELE_ENABLE_SOCIAL_LOGIN=true
AUS_ELE_OAUTH_GOOGLE_CLIENT_ID=
AUS_ELE_OAUTH_GOOGLE_CLIENT_SECRET=
AUS_ELE_OAUTH_GITHUB_CLIENT_ID=
AUS_ELE_OAUTH_GITHUB_CLIENT_SECRET=
# Optional discovery-document overrides. Every endpoint found in the document must pass
# HTTPS + the built-in host allowlist, otherwise the document is discarded.
AUS_ELE_OAUTH_GOOGLE_DISCOVERY_URL=
AUS_ELE_OAUTH_GITHUB_DISCOVERY_URL=
# Lifetime of the server-side one-time `state` (floor 60s) and outbound HTTP timeout
# for token/userinfo calls (floor 1s).
AUS_ELE_OAUTH_STATE_TTL_SECONDS=600
AUS_ELE_OAUTH_HTTP_TIMEOUT_SECONDS=8
# Throttles for the two endpoints, and the page we land on after the IdP round trip.
AUS_ELE_OAUTH_START_RATE_LIMIT=30
AUS_ELE_OAUTH_CALLBACK_RATE_LIMIT=60
AUS_ELE_OAUTH_LANDING_PATH=/login
# Overrides AUS_ELE_PUBLIC_BASE_URL only for the OAuth redirect_uri. It must match the
# callback URL registered at the IdP byte for byte; never taken from the request.
AUS_ELE_OAUTH_REDIRECT_BASE_URL=
# Escape hatch for self-hosted IdP proxies. false by default: opening it means the
# discovery URL decides where your code and access token go.
AUS_ELE_OAUTH_ALLOW_ANY_HOST=false

# Optional observability
AUS_ELE_OTEL_ENABLED=false
AUS_ELE_OTEL_EXPORTER=otlp
AUS_ELE_OTEL_EXPORTER_OTLP_ENDPOINT=
AUS_ELE_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
AUS_ELE_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
AUS_ELE_OTEL_EXPORTER_OTLP_HEADERS=
AUS_ELE_OTEL_EXPORTER_OTLP_INSECURE=false
AUS_ELE_OTEL_METRICS_ENABLED=false
AUS_ELE_JSON_LOGS=false
AUS_ELE_LOG_AGGREGATION_ENABLED=false
AUS_ELE_LOG_AGGREGATION_SINK=file
AUS_ELE_LOG_AGGREGATION_FILE_PATH=G:\\project\\aus-ele\\output\\observability.jsonl
AUS_ELE_LOG_AGGREGATION_ENDPOINT=
AUS_ELE_OPENLINEAGE_ENABLED=false
AUS_ELE_OPENLINEAGE_SINK=none
AUS_ELE_OPENLINEAGE_ENDPOINT=
AUS_ELE_OPENLINEAGE_FILE_PATH=G:\\project\\aus-ele\\output\\openlineage-events.jsonl

# AI Agent LLM Configuration (optional — system falls back to deterministic template mode without API key)
# Supported providers: openai, azure, ollama, custom
AUS_ELE_AGENT_LLM_PROVIDER=openai
AUS_ELE_AGENT_LLM_API_KEY=
AUS_ELE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
AUS_ELE_AGENT_LLM_MODEL=gpt-4o
AUS_ELE_AGENT_LLM_TIMEOUT=30
AUS_ELE_AGENT_LLM_MAX_TOKENS=4096
AUS_ELE_AGENT_LLM_TEMPERATURE=0.1

# --- P2 email channel (SMTP; 465 = implicit SSL; 163 uses client auth code) ---
AGENT_ALERT_SMTP_HOST=
AGENT_ALERT_SMTP_PORT=465
AGENT_ALERT_SMTP_USE_TLS=false
AGENT_ALERT_SMTP_USER=
AGENT_ALERT_SMTP_PASSWORD=
AGENT_ALERT_SMTP_FROM=
FEEDBACK_TO=

# --- 前端构建期开关（VITE_*，R5.4 / R2.4 / R5.1）---
# 三条必须知道的性质：
# 1. VITE_* 只有**构建期**注入这一条路。运行时改 nginx/compose 环境变量改不了已经编译进
#    bundle 的取值 —— 想让它们生效必须在 `docker compose build` 之前设好。
# 2. 这一份是本地 `docker compose build` 的插值来源；生产部署模板见 .env.docker.example，
#    而生产镜像由 CI 构建（docker-compose.prod.yml 只 pull），所以真正上线的取值还要看
#    GitHub Actions 的 repository vars（同名键）。三处缺一处 = 那个开关在线上拧不动。
# 3. 合法键名以 web/src/lib/flags.js 的注册表为准；web/src/lib/flagsGuard.test.js 会常驻
#    检查「注册表里的每个 flag 是否真的能在这三条链路上被拧动」，新增 flag 漏接线即变红。
#    宿主机直接 `npm run build`（不走 docker）时，vite 读的是 web/.env，不是本文件。
VITE_API_BASE=/api
# 匿名 bootstrap 写端点共享密钥（与后端 AUS_ELE_BOOTSTRAP_SECRET 同值；CI 里是 secret 而非 vars）
VITE_BOOTSTRAP_SECRET=
# 数据权利（导出/删除）入口：前端只做可见性，授权仍由后端 data_rights_routes 逐请求判定。
# 开它之前必须先确认后端端点已上线，否则用户看到按钮点了拿 403。
VITE_DATA_RIGHTS_UI=false
VITE_SUPPORT_EMAIL=
# 法务主体信息：留空时页面渲染成「尚未登记」，不会编造主体名或 ABN（见 lib/brand.js）。
# ABN 必须是 11 位数字，格式不符一律按未配置处理 —— 合同文本里的假 ABN 是刑事级问题。
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_ABN=
VITE_LEGAL_JURISDICTION=
# 分析采集（R5.1）：默认全关，关闭态 lib/analytics.js 零副作用（不注入脚本、不发请求）。
# 开启前置：/legal/dpa 第 4 条与 /legal/cookies 第 7 条必须已改成与实际采集一致的描述。
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_SDK_URL=
VITE_ANALYTICS_TOKEN=
VITE_ANALYTICS_HOST=
# 会话回放：必须与下面两项遮蔽**同时**为 true，否则 analytics.js 拒绝录制（Spec §159）。
VITE_ANALYTICS_SESSION_REPLAY=false
VITE_ANALYTICS_MASK_ALL_TEXT=false
VITE_ANALYTICS_MASK_ALL_INPUTS=false

# 批次 R3（可分享 URL 与渐进式导航）：四项都改「既有界面的默认行为」，各占一个回滚位。
# 关掉后的表现逐条写在 web/src/lib/flags.js 的 offState 里，门是 flagsGuard.test.js
# （它同时要求这四个键在 web/Dockerfile ARG、compose build arg、ci.yml vars 与
#  ci.yml 的 --build-arg 循环里都出现 —— 少一处 = 生产上拧不动）。
# 顺序纪律与 analytics 相同：先本地/预发点亮并跑过 browser 验收，再进生产。
VITE_URL_STATE_UI=false
VITE_SPA_NAV_UI=false
VITE_COMMAND_PALETTE_UI=false
VITE_MOBILE_NAV_UI=false

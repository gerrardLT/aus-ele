COMPOSE_PROJECT_NAME=aus-ele

# ---------------------------------------------------------------------------
# 生产部署（docker-compose.prod.yml）镜像寻址变量
# 仅生产服务器侧 /www/wwwroot/aus-ele/.env.prod 使用；本地开发用 docker-compose.yml 可忽略。
# 镜像引用格式：${REGISTRY}/${IMAGE_PREFIX}/<service>:${IMAGE_TAG}
# ---------------------------------------------------------------------------
# 容器镜像仓库地址（GitHub Container Registry）
REGISTRY=ghcr.io
# 镜像前缀：GitHub 仓库的 <owner>/<repo>（全小写）
IMAGE_PREFIX=<owner>/<repo>
# 部署镜像标签：完整 40 位 commit SHA；CI/CD 部署时由流水线写入，回滚时为上一稳定 SHA
IMAGE_TAG=<commit-sha>

# Host ports. Change these if Baota already has other containers using them.
WEB_HOST_PORT=18080
API_HOST_PORT=18085
REDIS_HOST_PORT=16379
PG_HOST_PORT=15432

# Database backend: postgresql (only supported option)
AUS_ELE_DB_BACKEND=postgresql

# PostgreSQL connection (required when AUS_ELE_DB_BACKEND=postgresql)
AUS_ELE_PG_PASSWORD=your-secure-pg-password
AUS_ELE_PG_MIN_CONNECTIONS=2
AUS_ELE_PG_MAX_CONNECTIONS=10
AUS_ELE_PG_CONNECT_TIMEOUT=10

# Use /api when web and backend are served from the same host via nginx.
VITE_API_BASE=/api
NPM_REGISTRY=https://registry.npmjs.org/

# R1.7 账户数据权利（自助导出 / 删除）。默认关：关掉时账户中心不出现该 tab，且隐私页
# 第 5 条自动改写成「请通过邮箱/反馈页申请」—— 判据与 flag 读同一个位，见
# web/src/lib/dataRights.js。
# 顺序约束（Spec §232 / R6.4）：翻成 true 必须**晚于**部署了
# backend/routes/data_rights_routes.py 的后端镜像。隐私页是法律文本，不做端点在线探测，
# 提前打开等于让隐私政策宣称一个线上不存在的自助入口（账户中心的面板会自己收起，法律页不会）。
VITE_DATA_RIGHTS_UI=false
# flag 关闭时隐私页给出的人工申请渠道；留空则文案改指站内「帮助与反馈」页。
VITE_SUPPORT_EMAIL=

# R2.4 法务主体信息（构建期注入前端）。留空是有意默认：法人与 ABN/ACN 属对外可核验事实，
# 不在代码里造值；未配置时 /legal/terms 第 1 条渲染「正在办理登记」而不是一个编出来的登记号。
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_ABN=
VITE_LEGAL_JURISDICTION=

# R5.1/R5.4 前端分析采集。默认全关：关闭态 lib/analytics.js 零副作用（不加载第三方代码、
# 不发任何请求），所以「未启用即未采集」这句法务承诺在代码层面成立。
#
# 启用顺序纪律（不可反）：先改 /legal/dpa 第 4 条与 /legal/cookies 第 7 条（那两条现在写的
# 是「未启用，启用前会先公示」），再翻 VITE_ANALYTICS_ENABLED。分析服务是在线子处理者，
# 数据出境属于对外披露事项，先采集后公示等于对用户提供不实陈述。
VITE_ANALYTICS_ENABLED=false
# SDK 脚本地址与上报端点由所选分析服务商提供；TOKEN 只能是客户端 public key
# （它会出现在浏览器产物与镜像层里，任何服务端写权限密钥都不得放这里）。
VITE_ANALYTICS_SDK_URL=
VITE_ANALYTICS_TOKEN=
VITE_ANALYTICS_HOST=
# 会话回放：两个遮蔽开关必须同时为 true，否则 analytics.js 直接拒绝录制（Spec §159）。
# 本平台界面本身就是项目名 + 财务数字，无遮蔽的回放等于把客户数据交给第三方留存。
VITE_ANALYTICS_SESSION_REPLAY=false
VITE_ANALYTICS_MASK_ALL_TEXT=false
VITE_ANALYTICS_MASK_ALL_INPUTS=false

# 批次 R3：URL 状态镜像 / SPA 导航 / ⌘K 面板 / 移动抽屉（判据与 offState 见 web/src/lib/flags.js）
VITE_URL_STATE_UI=false
VITE_SPA_NAV_UI=false
VITE_COMMAND_PALETTE_UI=false
VITE_MOBILE_NAV_UI=false

# Backend runtime
AUS_ELE_ENABLE_SCHEDULER=false
AUS_ELE_ENABLE_JOB_WORKER=false
AUS_ELE_WORKER_ENABLE_SCHEDULER=true
AUS_ELE_WORKER_ENABLE_JOB_WORKER=true
# R1.7 删除排期的执行者。这是全系统唯一物理删除数据的周期任务，所以有独立开关：停掉它
# 不应该顺手停掉市场同步（复用 AUS_ELE_ENABLE_SCHEDULER 就做不到这件事）。
# 没这个任务时，「30 天后永久删除」只是一句写在界面上的话 —— 端点只写排期行，没人读。
# 每小时一次（而非每天）：scheduled_delete_at 是给用户看过的精确时刻，日级扫描会让实际
# 删除比屏幕上那个日期晚近一天。多 worker 由 P0.7 认领锁按小时桶去重。
AUS_ELE_ENABLE_ACCOUNT_DELETION_SWEEP=true
AUS_ELE_ACCOUNT_DELETION_SWEEP_MINUTE=15
AUS_ELE_MARKET_SYNC_HOUR=1
AUS_ELE_MARKET_SYNC_MINUTE=20
AUS_ELE_FINGRID_HOURLY_SYNC_MINUTE=45
AUS_ELE_FINGRID_DAILY_SYNC_HOUR=4
AUS_ELE_FINGRID_DAILY_SYNC_MINUTE=10
AUS_ELE_CORS_ALLOW_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
AUS_ELE_CORS_ALLOW_CREDENTIALS=false

# JWT authentication (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUS_ELE_JWT_SECRET=
AUS_ELE_ACCESS_TOKEN_TTL_SECONDS=3600
AUS_ELE_SESSION_TTL_SECONDS=2592000

# R7 部署开关（2026-09-06）：自助注册与社交登录。规约见 docs/architecture/推迟项规约-R7-2026-09-06.md。
# 注册默认开（公测语义）；改 false 重启后注册/重发一律 403，既有账户登录与已发验证
# 链接不受影响（紧急回滚零代码，见 backend/routes/registration_routes.py）。
AUS_ELE_ENABLE_SELF_SERVICE_REGISTER=true
# 社交登录（Google/GitHub）。凭据留空 = 该提供方不广告、不出现（provider_config 返回 None，
# 不报错）。AUS_ELE_PUBLIC_BASE_URL 是对外根地址（redirect_uri 与邮件链接都用它），
# 必须 https 且与 IdP 控制台登记的回调完全一致；留空时社交登录端点报 501 而非静默错回调。
AUS_ELE_PUBLIC_BASE_URL=
AUS_ELE_OAUTH_REDIRECT_BASE_URL=
AUS_ELE_OAUTH_GOOGLE_CLIENT_ID=
AUS_ELE_OAUTH_GOOGLE_CLIENT_SECRET=
AUS_ELE_OAUTH_GITHUB_CLIENT_ID=
AUS_ELE_OAUTH_GITHUB_CLIENT_SECRET=

# Optional Fingrid integration
FINGRID_API_KEY=
FINGRID_BASE_URL=https://data.fingrid.fi/api
FINGRID_REQUEST_INTERVAL_SECONDS=6.5
FINGRID_TIMEOUT_SECONDS=30
FINGRID_DEFAULT_BACKFILL_START=2014-01-01T00:00:00Z
FINGRID_DEFAULT_INCREMENTAL_LOOKBACK_DAYS=30
NORDPOOL_API_BASE_URL=https://data-api.nordpoolgroup.com
NORDPOOL_ACCESS_TOKEN=
NORDPOOL_API_KEY=
NORDPOOL_TOKEN_URL=
NORDPOOL_CLIENT_ID=
NORDPOOL_CLIENT_SECRET=
ENTSOE_API_BASE_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_SECURITY_TOKEN=
ENTSOE_TIMEOUT_SECONDS=30

# Optional observability
AUS_ELE_OTEL_ENABLED=false
AUS_ELE_OTEL_EXPORTER=otlp
AUS_ELE_OTEL_EXPORTER_OTLP_ENDPOINT=
AUS_ELE_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
AUS_ELE_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
AUS_ELE_OTEL_EXPORTER_OTLP_HEADERS=
AUS_ELE_OTEL_EXPORTER_OTLP_INSECURE=false
AUS_ELE_OTEL_METRICS_ENABLED=false
AUS_ELE_JSON_LOGS=false
AUS_ELE_LOG_AGGREGATION_ENABLED=false
AUS_ELE_LOG_AGGREGATION_SINK=file
AUS_ELE_LOG_AGGREGATION_FILE_PATH=/app/output/observability.jsonl
AUS_ELE_LOG_AGGREGATION_ENDPOINT=
AUS_ELE_OPENLINEAGE_ENABLED=false
AUS_ELE_OPENLINEAGE_SINK=none
AUS_ELE_OPENLINEAGE_ENDPOINT=
AUS_ELE_OPENLINEAGE_FILE_PATH=/app/output/openlineage-events.jsonl

# --- P2 email channel (SMTP; 465 = implicit SSL; 163 uses client auth code) ---
AGENT_ALERT_SMTP_HOST=
AGENT_ALERT_SMTP_PORT=465
AGENT_ALERT_SMTP_USE_TLS=false
AGENT_ALERT_SMTP_USER=
AGENT_ALERT_SMTP_PASSWORD=
AGENT_ALERT_SMTP_FROM=
FEEDBACK_TO=

# --- MCP external tools (2026-08-15; stdio servers run via uvx, Tavily via HTTP) ---
# Master switch: set false to disable all MCP servers
AUS_ELE_MCP_ENABLED=true
# Tavily web search API key (https://tavily.com; free tier available).
# Leave empty to auto-disable the tavily server; other servers unaffected.
TAVILY_API_KEY=

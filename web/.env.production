VITE_API_BASE=http://35.72.12.242:8085/api

# R1.7 账户数据权利入口。保持 false 直到线上后端镜像包含
# backend/routes/data_rights_routes.py（Spec §232 / R6.4 的顺序约束）：隐私页第 5 条的
# 文案只读这个 flag、不做端点探测，提前打开会让隐私政策宣称一个线上不存在的自助入口。
VITE_DATA_RIGHTS_UI=false
VITE_SUPPORT_EMAIL=

# R2.4 法务主体信息。**留空是有意默认**：法人名称与 ABN/ACN 是对外可核验的法律事实，
# 代码里没有兜底值（见 web/src/lib/brand.js），未配置时服务条款第 1 条渲染成「正在办理登记」。
# 登记号必须是 11 位数字（可含空格/连字符），格式不符按未配置处理，不会照抄进合同文本。
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_ABN=
VITE_LEGAL_JURISDICTION=

# R5.1 前端分析采集（注册表见 web/src/lib/flags.js，门见 flagsGuard.test.js）。
# 默认 false 是有意的：关闭态 lib/analytics.js 不加载任何第三方代码、不发任何请求。
# 启用前必须先改 /legal/dpa 第 4 条与 /legal/cookies 第 7 条的「未启用」表述 —— 顺序不能反。
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_SDK_URL=
VITE_ANALYTICS_TOKEN=
VITE_ANALYTICS_HOST=
# 回放遮蔽两个开关不同时为 true 时，即使 SESSION_REPLAY=true 也不会录制（Spec §159）。
VITE_ANALYTICS_SESSION_REPLAY=false
VITE_ANALYTICS_MASK_ALL_TEXT=false
VITE_ANALYTICS_MASK_ALL_INPUTS=false

# 批次 R3（可分享 URL 与渐进式导航）。宿主机 `npm run build` 读的是本文件，
# docker 构建读的是 compose/CI 传进来的 build-arg —— 两条路径都要点亮才算真开了。
# 验收顺序：本地开 → browser-use 截图验收 → 预发开 → 生产开。
VITE_URL_STATE_UI=false
VITE_SPA_NAV_UI=false
VITE_COMMAND_PALETTE_UI=false
VITE_MOBILE_NAV_UI=false
